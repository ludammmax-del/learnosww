# GOOGLE VERTEX AI: Service account credentials & Vertex AI project config
# Use this in deployed environments; never commit service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# For local development, use a private ignored file instead.
GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"
VERTEX_PROJECT="your-google-cloud-project-id"
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"
VERTEX_LOCATION="us-central1"
USE_VERTEX_AI="true"

# GEMINI_MODEL: Gemini Flash model (gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_API_KEY: Optional fallback Gemini API Key
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENALEX_API_KEY: Optional official OpenAlex API Key (https://api.openalex.org).
# Leave empty for free polite pool access (100,000 requests/day).
OPENALEX_API_KEY=""

# Firebase web app config (public client configuration; required for auth and sync).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
